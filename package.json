{
  "name": "bisz-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 4005",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed"
  },
  "dependencies": {
    "@basis/schema": "link:@basis/schema",
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.0",
    "drizzle-orm": "0.45.2",
    "element-plus": "^2.13.2",
    "jose": "^6.2.7",
    "markdown-it": "^14.1.0",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "openid-client": "^6.8.2",
    "pg": "^8.22.0",
    "vue": "^3.5.28",
    "vue-router": "^5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "bun@1.3.14",
