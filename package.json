{
  "name": "bisz-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 4005",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "bun test",
    "test:component": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed"
  },
  "dependencies": {
    "@basis/schema": "file:./packages/basis-schema",
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.5",
    "drizzle-orm": "0.45.4",
    "element-plus": "^2.14.8",
    "jose": "^6.2.17",
    "markdown-it": "^15.0.3",
    "nuxt": "4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "undici": "^8.12.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/markdown-it": "^14.2.0",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
