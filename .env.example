# Nuxt Auth Utils seals the HttpOnly portal session. Use at least 32 random characters.
NUXT_SESSION_PASSWORD=

# DevConnect / basis-auth OIDC client configuration.
BASIS_PORTAL_ORIGIN=http://localhost:4005
BASIS_AUTH_ISSUER=http://localhost:3000
BASIS_AUTH_CLIENT_ID=
BASIS_AUTH_CLIENT_SECRET=
BASIS_AUTH_RESOURCE=devconnect://noesis

# DevConnect Assets confidential client and API. Keep the secret server-side.
BASIS_ASSETS_CLIENT_ID=66d015c8-1e3f-4a0d-b0f5-3bc3c6b72a86
BASIS_ASSETS_CLIENT_SECRET=
# Base64-encoded 32-byte AES key for encrypted Assets connections.
BASIS_ASSETS_TOKEN_KEY=
BISZ_ASSETS_API_URL=http://localhost:5000
NUXT_PUBLIC_BISZ_ASSETS_API_URL=http://localhost:5000

# Separate portal product database. Never point this at the Basis Auth database.
DATABASE_URL=postgresql://bisz_portal:bisz_portal@localhost:5432/bisz_portal

# Private Basis Auth API used to validate exact member UUIDs.
BASIS_AUTH_INTERNAL_URL=http://localhost:3001
BASIS_AUTH_INTERNAL_TOKEN=

# Real Basis user UUID used as the idempotent seed project's owner.
PORTAL_SEED_OWNER_ID=

# GitHub App credentials used for authenticated repository metadata and README access.
GITHUB_APP_ID=
# Absolute path, or a path relative to the portal working directory, to the downloaded PEM key.
GITHUB_APP_PRIVATE_KEY_PATH=
# Comma-separated DNS servers used only for GitHub API requests. This avoids
# broken local resolvers without changing the machine-wide DNS configuration.
GITHUB_DNS_SERVERS=1.1.1.1,8.8.8.8
